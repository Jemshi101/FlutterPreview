<!-- Loaded only when the Dart plugin is installed (optional dependency in plugin.xml). -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.lineMarkerProvider language="Dart"
                                        implementationClass="in.bleuphoenix.flutterpreview.dart.PreviewLineMarkerProvider"/>
        <intentionAction>
            <language>Dart</language>
            <className>in.bleuphoenix.flutterpreview.dart.CreatePreviewIntention</className>
            <category>Flutter</category>
        </intentionAction>
    </extensions>

    <actions>
        <action id="FlutterPreview.GeneratePreview"
                class="in.bleuphoenix.flutterpreview.dart.GeneratePreviewAction"
                text="Generate Flutter Preview…"
                description="Add a @Preview for the widget at the caret to a file in the package's previews/ folder"
                icon="AllIcons.Actions.Preview">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
