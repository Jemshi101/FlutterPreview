<idea-plugin>
    <id>in.bleuphoenix.flutterpreview</id>
    <name>Flutter Preview</name>
    <vendor url="https://github.com/Jemshi101/FlutterPreview">Jemsheer K D</vendor>
    <!-- <description> and <change-notes> are added at build time from docs/marketplace/description.html and
         CHANGELOG.md (see build.gradle.kts). -->

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="flutterpreview-dart.xml">Dart</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Flutter Preview" displayType="BALLOON"/>
        <!-- Dev-only screenshot mode; does nothing unless -Dflutterpreview.screenshots is set. -->
        <postStartupActivity implementation="in.bleuphoenix.flutterpreview.dev.ScreenshotActivity"/>
        <toolWindow id="Flutter Preview"
                    anchor="right"
                    icon="/icons/flutterPreview.svg"
                    factoryClass="in.bleuphoenix.flutterpreview.ui.FlutterPreviewToolWindowFactory"/>
    </extensions>
</idea-plugin>
